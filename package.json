{
  "name": "mangaloop",
  "version": "1.0.0",
  "private": true,
  "description": "MangaLoop — editora digital colaborativa que transforma comentarios das redes sociais em mangas originais com auxilio de IA.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "migrate": "node src/cli/migrate.js",
    "seed": "node src/cli/seed.js",
    "bootstrap:admin": "node src/cli/bootstrap-admin.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "lint": "node src/cli/lint.js",
    "build": "node src/cli/build.js"
  },
  "dependencies": {},
  "devDependencies": {}
}