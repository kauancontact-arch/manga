# ---------------------------------------------------------------------------
# MangaLoop — exemplo de ambiente. Copie para .env e preencha.
# NUNCA faca commit de .env. Nenhum valor real deve aparecer neste arquivo.
# ---------------------------------------------------------------------------

# Banco de dados.
# SQLite (padrao de desenvolvimento):   file:./data/mangaloop.sqlite
# PostgreSQL (producao):                postgresql://usuario:senha@host:5432/mangaloop
DATABASE_URL=file:./data/mangaloop.sqlite

# OpenAI — backend apenas. Deixe vazio para operar em MODO DEMO (sem custo).
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
# base opcional (proxy/gateway corporativo)
OPENAI_BASE_URL=

# Habilita chamadas pagas reais. Sem "true" o sistema nunca chama a API paga.
AI_LIVE_ENABLED=false

# Administracao
ADMIN_USERNAME=kauan
# Usada somente no bootstrap. Remova do ambiente depois de criar o usuario.
ADMIN_INITIAL_PASSWORD=
# Segredo de assinatura de sessao/CSRF. Gere com: openssl rand -base64 48
AUTH_SECRET=

APP_URL=http://localhost:3000
PORT=3000
# Em producao use "production" (ativa cookie Secure e desliga telas de debug).
NODE_ENV=development

# Armazenamento de objetos compativel com S3. Vazio = armazenamento local em ./data/storage
STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# Orcamento de IA (USD). Vazio = sem teto definido; o sistema exigira confirmacao.
MONTHLY_AI_BUDGET_USD=
PER_MANGA_AI_BUDGET_USD=

# Tarifas (USD) usadas para estimativa. Vazio = custo desconhecido (nunca exibe zero).
PRICE_TEXT_INPUT_PER_MTOK=
PRICE_TEXT_OUTPUT_PER_MTOK=
PRICE_IMAGE_PER_CALL_LOW=
PRICE_IMAGE_PER_CALL_MEDIUM=
PRICE_IMAGE_PER_CALL_HIGH=
PRICE_TABLE_UPDATED_AT=

# Worker / agendamento
WORKER_TOKEN=
WORKER_POLL_MS=2000
MAX_CONCURRENT_JOBS=2
EDITORIAL_TIMEZONE=America/Sao_Paulo
